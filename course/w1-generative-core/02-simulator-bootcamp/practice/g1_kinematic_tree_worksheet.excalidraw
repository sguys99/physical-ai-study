      "link": null,
      "locked": false,
      "fontSize": 15,
      "fontFamily": 5,
      "text": "python 02_g1_inspect.py --csv     →  artifacts/W1-M2/joints_g1.csv",
      "originalText": "python 02_g1_inspect.py --csv     →  artifacts/W1-M2/joints_g1.csv",
