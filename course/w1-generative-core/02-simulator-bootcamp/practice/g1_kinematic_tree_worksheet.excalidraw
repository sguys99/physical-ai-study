    {
      "id": "t004",
      "type": "text",
      "x": 90,
      "y": 126,
      "width": 841,
      "height": 17,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a003",
      "roundness": null,
      "seed": 1583617198,
      "version": 1,
      "versionNonce": 118713610,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785000000000,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 5,
      "text": "채운 뒤 lesson.md §5.4 표와 대조하고, 틀린 칸이 있으면 왜 틀렸는지 메모하세요. 모르는 칸은 물음표로 남겨 questions-for-team.md 로 옮깁니다.",
      "originalText": "채운 뒤 lesson.md §5.4 표와 대조하고, 틀린 칸이 있으면 왜 틀렸는지 메모하세요. 모르는 칸은 물음표로 남겨 questions-for-team.md 로 옮깁니다.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
