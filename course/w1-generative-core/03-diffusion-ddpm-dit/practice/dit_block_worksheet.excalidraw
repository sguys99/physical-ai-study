  {
   "id": "t004",
   "type": "text",
   "x": 90,
   "y": 126,
   "width": 1016,
   "height": 18,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
