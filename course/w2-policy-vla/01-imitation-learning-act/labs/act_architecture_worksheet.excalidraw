   "isDeleted": false,
   "boundElements": null,
   "updated": 1785000000000,
   "link": null,
   "locked": false,
   "fontSize": 15,
   "fontFamily": 5,
   "text": "대조 대상:  lesson.md §4.1(학습) · §4.2(추론) · §2.5 · §2.7 · §6.4   +   practice 실측  predict_action_chunk(obs).shape",
   "originalText": "대조 대상:  lesson.md §4.1(학습) · §4.2(추론) · §2.5 · §2.7 · §6.4   +   practice 실측  predict_action_chunk(obs).shape",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t004",
   "type": "text",
   "x": 90,
   "y": 126,
   "width": 825,
   "height": 18,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
