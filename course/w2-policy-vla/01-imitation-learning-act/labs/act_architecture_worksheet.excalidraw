  {
   "id": "t_z_cmp",
   "type": "text",
   "x": 98,
   "y": 1233,
   "width": 774,
   "height": 122,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
