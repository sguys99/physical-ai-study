    },
    {
      "id": "t002",
      "type": "text",
      "x": 90,
      "y": 78,
      "width": 474,
      "height": 18,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a001",
      "roundness": null,
      "seed": 425240460,
      "version": 1,
      "versionNonce": 965601876,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785000000000,
      "link": null,
      "locked": false,
      "fontSize": 15,
      "fontFamily": 5,
      "text": "완성본이 아닙니다. 아래를 먼저 돌린 뒤, 나온 인덱스를 각 노드의 빈칸에 손으로 적으세요.",
      "originalText": "완성본이 아닙니다. 아래를 먼저 돌린 뒤, 나온 인덱스를 각 노드의 빈칸에 손으로 적으세요.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t003",
      "type": "text",
      "x": 90,
      "y": 102,
      "width": 613,
      "height": 18,
      "angle": 0,
      "strokeColor": "#0b7285",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a002",
      "roundness": null,
      "seed": 1161354352,
      "version": 1,
      "versionNonce": 842155587,
      "isDeleted": false,
      "boundElements": null,
