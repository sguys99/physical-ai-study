  {
   "id": "t004",
   "type": "text",
   "x": 90,
   "y": 126,
   "width": 1016,
   "height": 18,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a003",
   "roundness": null,
   "seed": 45380107,
   "version": 1,
   "versionNonce": 218204301,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1785000000000,
   "link": null,
   "locked": false,
   "fontSize": 14,
   "fontFamily": 5,
   "text": "채운 뒤 lesson.md §7.1과 대조하고, 틀린 칸은 왜 틀렸는지 메모하세요. 모르는 칸은 물음표로 남겨 questions-for-team.md 로 옮깁니다.  ← W1 체크포인트 2번 문항의 뼈대입니다.",
   "originalText": "채운 뒤 lesson.md §7.1과 대조하고, 틀린 칸은 왜 틀렸는지 메모하세요. 모르는 칸은 물음표로 남겨 questions-for-team.md 로 옮깁니다.  ← W1 체크포인트 2번 문항의 뼈대입니다.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
