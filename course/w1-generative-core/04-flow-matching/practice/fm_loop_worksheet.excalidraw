  {
   "id": "t_rule",
   "type": "text",
   "x": 98,
   "y": 188,
   "width": 644,
   "height": 70,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
