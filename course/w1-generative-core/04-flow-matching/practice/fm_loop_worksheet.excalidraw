  {
   "id": "t002",
   "type": "text",
   "x": 90,
   "y": 78,
   "width": 688,
   "height": 19,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
